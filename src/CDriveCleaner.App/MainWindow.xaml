<Window x:Class="CDriveCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CDriveCleaner.App.Controls"
        xmlns:vm="clr-namespace:CDriveCleaner.App.ViewModels"
        Title="C 盘清理"
        Icon="app.ico"
        Width="1200" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource TextFont}" FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <c:BoolToVisibility x:Key="Shown" />
        <c:BoolToVisibility x:Key="Hidden" Invert="True" />
        <c:TextToVisibility x:Key="HasText" />

        <CollectionViewSource x:Key="RuleView" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- One rule: tick, name with its note, risk, then size with a bar in the category colour. -->
        <DataTemplate x:Key="RuleTemplate" DataType="{x:Type vm:RuleItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" MinHeight="0" Padding="0" Margin="0,-6,10,-6"
                          VerticalAlignment="Top" AutomationProperties.Name="{Binding Name, StringFormat=清理 {0}}"
                          IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Secondary}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" Visibility="{Binding HasNote, Converter={StaticResource Shown}}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" Margin="0,2,0,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasStatus, Converter={StaticResource Shown}}" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource RiskTag}" Margin="12,1,0,0" VerticalAlignment="Top"
                        Visibility="{Binding IsMedium, Converter={StaticResource Shown}}">
                    <TextBlock Text="{Binding RiskText}" Style="{StaticResource RiskTagText}" />
                </Border>
                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Amount}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding FilesText}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,1,0,0" />
                    <Border Height="3" Width="112" CornerRadius="1.5" Margin="0,5,0,0" HorizontalAlignment="Right"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}">
                        <Rectangle RadiusX="1.5" RadiusY="1.5" Fill="{Binding Group.Brush}" RenderTransformOrigin="1,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding BarFraction}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One source of the selected rule: keep it or clean it, and what is inside. -->
        <DataTemplate x:Key="SourceTemplate" DataType="{x:Type vm:SourceItem}">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox IsChecked="{Binding IsIncluded}" MinWidth="0" MinHeight="0" Padding="0" Margin="0,-6,8,-6" VerticalAlignment="Top"
                          AutomationProperties.Name="{Binding AutomationName}"
                          IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding FolderToOpen}" />
                    <TextBlock Text="{Binding OwnerHint}" Style="{StaticResource Secondary}"
                               Visibility="{Binding OwnerHint, Converter={StaticResource HasText}}" />
                    <TextBlock Text="其中一部分文件夹你已选择保留" Style="{StaticResource Secondary}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding IsPartlyKept, Converter={StaticResource Shown}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Amount}" FontSize="13.5" Margin="12,0,0,0" />

                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="3" CornerRadius="1.5" Margin="0,6,0,0"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <Rectangle RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0,0.5"
                               Fill="{Binding DataContext.Group.Brush, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Border>

                <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="打开文件夹"
                            Tag="{Binding FolderToOpen}" Click="OpenFolder_Click" Margin="12,0,0,0"
                            AutomationProperties.Name="{Binding Label, StringFormat=打开 {0} 所在文件夹}" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                            Visibility="{Binding HasMaybeUseful, Converter={StaticResource Shown}}">
                    <TextBlock Text="{Binding MaybeUsefulText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <ItemsControl ItemsSource="{Binding UsefulFiles}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:UsefulFile}">
                                <DockPanel Margin="0,2,0,0" ToolTip="{Binding FullPath}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Secondary}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid x:Name="Page" Margin="32,12,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title and the two window-level actions. -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource RiskTag}" Margin="0,0,12,0"
                            Visibility="{Binding ShippedRules, Converter={StaticResource Hidden}}"
                            ToolTip="{Binding RulesPath}">
                        <TextBlock Style="{StaticResource RiskTagText}" Text="{Binding RulesFileName, StringFormat=测试用规则：{0}}" />
                    </Border>
                    <Button x:Name="AdminButton" Content="以管理员身份重新扫描" Click="AdminButton_Click"
                            ToolTip="系统文件夹（Windows 日志、更新缓存、其他用户的临时文件等）需要管理员权限才能读取和清理"
                            Visibility="{Binding IsElevated, Converter={StaticResource Hidden}}"
                            IsEnabled="{Binding IsIdle}" />
                    <TextBlock Text="管理员" Style="{StaticResource Secondary}" VerticalAlignment="Center"
                               Visibility="{Binding IsElevated, Converter={StaticResource Shown}}" />
                    <ToggleButton x:Name="HistoryToggle" Content="清理记录" Margin="8,0,0,0"
                                  IsChecked="{Binding ShowHistory}" IsEnabled="{Binding IsIdle}" />
                </StackPanel>
                <TextBlock Text="C 盘清理" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- The drive as one strip: the memorable element of the window. -->
            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Amount}" FontSize="17" />
                        <TextBlock Text="{Binding AfterText}" Style="{StaticResource Amount}" FontSize="17" Margin="18,0,0,0"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding AfterText, Converter={StaticResource HasText}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DriveText}" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Bottom" />
                </DockPanel>
                <c:CapacityBar Snapshot="{Binding Capacity}" Height="30" Margin="0,10,0,0"
                               AutomationProperties.Name="{Binding DriveText}" />
                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GroupItem}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Secondary}" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding BytesText}" Style="{StaticResource Secondary}" Margin="6,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Rules and the selected rule's details. -->
            <Grid Grid.Row="2" Margin="0,20,0,0" Visibility="{Binding ShowHistory, Converter={StaticResource Hidden}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <Border DockPanel.Dock="Top" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                            Visibility="{Binding HasResult, Converter={StaticResource Shown}}">
                        <TextBlock x:Name="ResultBanner" Text="{Binding ResultText}" Style="{StaticResource Body}" />
                    </Border>
                    <CheckBox DockPanel.Dock="Bottom" x:Name="ShowEmptyToggle" Margin="14,10,0,0" MinWidth="0"
                              IsChecked="{Binding ShowEmpty}" Content="{Binding EmptyToggleText}"
                              Visibility="{Binding HasEmpty, Converter={StaticResource Shown}}" />
                    <ListBox x:Name="RuleList" ItemsSource="{Binding Source={StaticResource RuleView}}"
                             SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource RuleTemplate}"
                             ItemContainerStyle="{StaticResource RuleRow}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             AutomationProperties.Name="清理项目">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,16,12,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Name.BytesText}" Style="{StaticResource Secondary}" />
                                            <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2" Fill="{Binding Name.Brush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name.Name}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>

                <Border Grid.Column="2" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Padding="22,20,22,10"
                                  DataContext="{Binding Selected}" AutomationProperties.Name="详细信息">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource RiskTag}" VerticalAlignment="Top" Margin="10,4,0,0"
                                        Visibility="{Binding IsMedium, Converter={StaticResource Shown}}">
                                    <TextBlock Text="{Binding RiskText}" Style="{StaticResource RiskTagText}" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasDescription, Converter={StaticResource Shown}}" />
                            <Border CornerRadius="6" Padding="12,9" Margin="0,12,0,0"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{Binding HasNote, Converter={StaticResource Shown}}">
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Body}" FontSize="13" />
                            </Border>

                            <TextBlock Text="{Binding StatsText}" Style="{StaticResource Amount}" Margin="0,16,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SkippedText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasSkipped, Converter={StaticResource Shown}}" />
                            <ItemsControl ItemsSource="{Binding WarningLines}" Margin="0,6,0,0"
                                          Visibility="{Binding HasWarnings, Converter={StaticResource Shown}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,18,0,0" Visibility="{Binding HasLastClean, Converter={StaticResource Shown}}">
                                <TextBlock Text="上次清理" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding LastCleanText}" Style="{StaticResource Body}" FontSize="13" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding FailureLines}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}" Margin="0,1,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Margin="0,22,0,0" Visibility="{Binding HasSources, Converter={StaticResource Shown}}">
                                <TextBlock Text="来自哪里" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="按所在文件夹和留下它们的程序归类。取消勾选的会保留，不会被删除。"
                                           Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,14" />
                                <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource SourceTemplate}"
                                              AutomationProperties.Name="来源" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Past cleans. -->
            <DockPanel Grid.Row="2" Margin="0,20,0,0" Visibility="{Binding ShowHistory, Converter={StaticResource Shown}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding HistorySummary}" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" />
                    <TextBlock Text="清理记录" Style="{StaticResource SectionTitle}" FontSize="17" />
                </DockPanel>
                <Grid>
                    <TextBlock Text="还没有清理记录。完成一次清理后，这里会记下每次释放了多少空间。" Style="{StaticResource Body}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasHistory, Converter={StaticResource Hidden}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasHistory, Converter={StaticResource Shown}}">
                        <ItemsControl ItemsSource="{Binding History}" AutomationProperties.Name="清理记录">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryItem}">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FreedText}" Style="{StaticResource Amount}" FontSize="17" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding WhenText}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Secondary}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding RulesText}" Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- Status on the left, the actions on the right. -->
            <DockPanel Grid.Row="3" Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"
                               Visibility="{Binding IsIdle, Converter={StaticResource Shown}}" />
                    <Button x:Name="ScanButton" Content="重新扫描" Click="ScanButton_Click" IsEnabled="{Binding CanScan}"
                            Visibility="{Binding IsIdle, Converter={StaticResource Shown}}" />
                    <Button x:Name="CleanButton" Style="{StaticResource AccentButtonStyle}" Content="{Binding CleanButtonText}"
                            Click="CleanButton_Click" IsEnabled="{Binding CanClean}" Margin="8,0,0,0" MinWidth="120"
                            Visibility="{Binding IsIdle, Converter={StaticResource Shown}}" AutomationProperties.AutomationId="CleanButton" />
                    <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click" MinWidth="88"
                            Visibility="{Binding IsBusy, Converter={StaticResource Shown}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="150" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,12,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource Shown}}" />
                    <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Confirmation: the only way to delete. Cancel has the focus and answers Enter and Esc. -->
        <Grid x:Name="ConfirmLayer" Visibility="Collapsed" Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border Width="540" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8"
                    BorderThickness="1" Padding="26,24"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    AutomationProperties.Name="确认清理">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="永久删除这些文件？" Style="{StaticResource PageTitle}" FontSize="20" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Body}" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="不经过回收站，删除后无法恢复。正在使用的文件会自动跳过。" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="ConfirmCancel" Content="取消" MinWidth="96" IsDefault="True" IsCancel="True"
                                Click="ConfirmCancel_Click" AutomationProperties.AutomationId="ConfirmCancel" />
                        <Button x:Name="ConfirmDelete" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                                Click="ConfirmDelete_Click" AutomationProperties.AutomationId="ConfirmDelete" />
                    </StackPanel>
                    <ItemsControl x:Name="ConfirmNotes" DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13" Margin="0,2,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <ItemsControl x:Name="ConfirmList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RuleItem}">
                                    <DockPanel Margin="0,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Amount}" FontSize="14" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource RiskTag}" Margin="0,0,12,0"
                                                Visibility="{Binding IsMedium, Converter={StaticResource Shown}}">
                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource RiskTagText}" />
                                        </Border>
                                        <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2" Fill="{Binding Group.Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
