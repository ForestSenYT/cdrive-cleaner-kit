<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>CDriveCleaner</AssemblyName>
    <RootNamespace>CDriveCleaner.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ShipRules>true</ShipRules>
    <!-- Application.ThemeMode (the built-in Fluent theme) is still marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Precompiled code starts noticeably faster; it only applies to dotnet publish. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDriveCleaner.Core\CDriveCleaner.Core.csproj" />
  </ItemGroup>

</Project>
