{
  "$schema": "./rules.schema.json",
  "format": 1,
  "rules": [
    {
      "id": "user-temp",
      "name": "当前用户临时文件",
      "group": "临时文件",
      "description": "程序运行和安装时留在用户临时目录里的文件。",
      "risk": "low",
      "default_selected": true,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [{ "root": "%TEMP%" }]
    },
    {
      "id": "system-temp",
      "name": "系统临时文件",
      "group": "临时文件",
      "description": "系统服务和安装程序留在 Windows 临时目录里的文件。",
      "risk": "low",
      "default_selected": true,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [{ "root": "%SystemRoot%/Temp" }]
    },
    {
      "id": "service-temp",
      "name": "服务账户临时文件",
      "group": "临时文件",
      "description": "系统服务账户各自临时目录里的文件。",
      "risk": "low",
      "default_selected": true,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [
        { "root": "%SystemRoot%/ServiceProfiles/*/AppData/Local/Temp" },
        { "root": "%SystemRoot%/System32/config/systemprofile/AppData/Local/Temp" },
        { "root": "%SystemRoot%/SysWOW64/config/systemprofile/AppData/Local/Temp" }
      ]
    },
    {
      "id": "store-app-temp",
      "name": "应用商店应用临时文件",
      "group": "临时文件",
      "description": "应用商店应用在各自沙盒临时目录里留下的文件。",
      "risk": "low",
      "default_selected": true,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/Temp" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/!*/Temp" }
      ]
    },
    {
      "id": "winsxs-temp",
      "name": "WinSxS 临时文件",
      "group": "临时文件",
      "description": "系统安装更新时留下的临时文件：WinSxS 里的清单缓存（ManifestCache）和 Windows 目录下的 CbsTemp。",
      "risk": "low",
      "default_selected": true,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [
        { "root": "%SystemRoot%/WinSxS/ManifestCache" },
        { "root": "%SystemRoot%/CbsTemp" }
      ]
    },
    {
      "id": "programdata-temp",
      "name": "ProgramData 临时目录",
      "group": "临时文件",
      "description": "ProgramData 下 temp 目录里的文件，腾讯等软件更新时会在这里留下下载残留。",
      "risk": "low",
      "default_selected": true,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [{ "root": "%ProgramData%/temp" }]
    },
    {
      "id": "chkdsk-found",
      "name": "磁盘检查恢复的文件碎片",
      "group": "临时文件",
      "description": "磁盘检查（chkdsk）修复文件系统时，把无法归位的数据存成系统盘根目录下 FOUND.000 等目录里的 .CHK 文件。",
      "note": "这些碎片偶尔是损坏文件仅剩的数据。需要从中找回内容时先保留，删除后无法恢复。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemDrive%/Found.*" }]
    },
    {
      "id": "error-reports",
      "name": "Windows 错误报告",
      "group": "日志与报告",
      "description": "程序和系统出错时生成的报告及内核实时转储。",
      "note": "正在排查崩溃或蓝屏问题时先保留。",
      "risk": "low",
      "default_selected": true,
      "kind": "files",
      "targets": [
        { "root": "%ProgramData%/Microsoft/Windows/WER" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Microsoft/Windows/WER" },
        { "root": "%SystemRoot%/LiveKernelReports" }
      ]
    },
    {
      "id": "windows-logs",
      "name": "Windows 日志文件",
      "group": "日志与报告",
      "description": "系统安装、更新、诊断和磁盘检查过程写下的日志，以及各用户目录下系统组件的日志。",
      "risk": "low",
      "default_selected": true,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [
        {
          "root": "%SystemRoot%",
          "include": ["*.log", "*log.txt", "SchedLgU.txt", "Panther/*.log", "Performance/WinSAT/*.log"]
        },
        { "root": "%SystemRoot%/Logs" },
        { "root": "%SystemRoot%/debug" },
        { "root": "%ProgramData%/USOShared/Logs" },
        { "root": "%SystemRoot%/Performance/WinSAT/DataStore" },
        { "root": "%SystemRoot%/System32/LogFiles", "include": ["*/*"], "exclude": ["Sum"] },
        { "root": "%SystemRoot%/System32/WDI/LogFiles/*" },
        { "root": "%SystemDrive%/Logs" },
        { "root": "%SystemDrive%/System Volume Information/Chkdsk" },
        {
          "root": "%SystemDrive%/Users/*/AppData",
          "include": [
            "Local/Microsoft/Windows/*.log",
            "Local/MigWiz/*.log",
            "Local/Microsoft/CLR_*/*.log",
            "Local/Microsoft/CLR_*/*/*.log",
            "Roaming/Microsoft/Windows/*.log"
          ]
        },
        {
          "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC",
          "include": [
            "Microsoft/CLR_*/*.log",
            "Microsoft/CLR_*/*/*.log",
            "!*/Microsoft/CLR_*/*.log",
            "!*/Microsoft/CLR_*/*/*.log"
          ]
        }
      ]
    },
    {
      "id": "crash-dumps",
      "name": "崩溃转储文件",
      "group": "日志与报告",
      "description": "系统蓝屏和程序崩溃时保存的内存转储。",
      "note": "需要分析蓝屏或崩溃原因时先保留。",
      "risk": "low",
      "default_selected": false,
      "kind": "files",
      "targets": [
        { "root": "%SystemRoot%", "include": ["MEMORY.DMP", "Minidump"] },
        { "root": "%SystemDrive%/Users/*/AppData/Local/CrashDumps" }
      ]
    },
    {
      "id": "event-logs",
      "name": "Windows 事件日志",
      "group": "日志与报告",
      "description": "事件查看器里的系统、应用和安全事件记录（.evtx 文件）。",
      "note": "删除后事件查看器里的历史事件（包括安全审核记录）就没有了，排查问题时无据可查。系统正在写入的日志会被自动跳过，实际删掉的多是停用通道和存档的日志。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [{ "root": "%SystemRoot%/System32/winevt/Logs" }]
    },
    {
      "id": "update-history",
      "name": "Windows 更新历史记录",
      "group": "日志与报告",
      "description": "Windows 更新保存的安装记录数据库（SoftwareDistribution 下的 DataStore）。",
      "note": "删除后“更新历史记录”会被清空，Windows 更新下次检查时要重新扫描。更新服务正在使用的文件会被跳过。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemRoot%/SoftwareDistribution/DataStore" }]
    },
    {
      "id": "defender-history",
      "name": "Windows Defender 保护历史记录",
      "group": "日志与报告",
      "description": "Windows Defender 的保护历史记录。记录过多时打开“保护历史记录”页面可能闪退。",
      "note": "清理后保护历史记录被清空，无法再从中还原被隔离的文件。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%ProgramData%/Microsoft/Windows Defender/Scans/History" }]
    },
    {
      "id": "defender-support",
      "name": "微软杀毒软件诊断文件",
      "group": "日志与报告",
      "description": "Windows Defender、MSE、SCEP 等微软杀毒软件的诊断日志（Support）和 LocalCopy 目录。",
      "note": "Support 里是诊断日志，删除后排查杀毒软件问题时没有历史日志。LocalCopy 的用途没有公开说明，原规则表把它算作无用文件。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [
        { "root": "%ProgramData%/Microsoft/Windows Defender/LocalCopy" },
        { "root": "%ProgramData%/Microsoft/Windows Defender/Support" },
        { "root": "%ProgramData%/Microsoft/Windows Defender/Network Inspection System/Support" },
        { "root": "%ProgramData%/Microsoft/Microsoft Antimalware/LocalCopy" },
        { "root": "%ProgramData%/Microsoft/Microsoft Antimalware/Support" },
        { "root": "%ProgramData%/Microsoft/Microsoft Antimalware/Network Inspection System/Support" }
      ]
    },
    {
      "id": "inet-cache",
      "name": "系统网页缓存",
      "group": "缓存",
      "description": "系统网络组件（WinINet）为各账户和应用容器保存的网页缓存，包括旧版 Edge 的缓存。",
      "risk": "low",
      "default_selected": true,
      "kind": "files",
      "targets": [
        { "root": "%SystemDrive%/Users/*/AppData/Local/Microsoft/Windows/INetCache" },
        { "root": "%SystemRoot%/ServiceProfiles/*/AppData/Local/Microsoft/Windows/INetCache" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/INetCache" },
        { "root": "%SystemRoot%/System32/config/systemprofile/AppData/Local/Microsoft/Windows/INetCache" },
        { "root": "%SystemRoot%/SysWOW64/config/systemprofile/AppData/Local/Microsoft/Windows/INetCache" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/!*/INetCache" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/MicrosoftEdge/Cache" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/!*/MicrosoftEdge/Cache" }
      ]
    },
    {
      "id": "inet-cookies",
      "name": "系统网络组件 Cookie",
      "group": "缓存",
      "description": "系统网络组件（WinINet）为各账户和应用容器保存的 Cookie，IE、旧版 Edge 和部分应用商店应用使用它们。",
      "note": "清理后这些浏览器和应用会退出已登录的网站或账号，需要重新登录。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [
        { "root": "%SystemDrive%/Users/*/AppData/Local/Microsoft/Windows/INetCookies" },
        { "root": "%SystemDrive%/Users/*/AppData/Roaming/Microsoft/Windows/Cookies" },
        { "root": "%SystemRoot%/ServiceProfiles/*/AppData/Local/Microsoft/Windows/INetCookies" },
        { "root": "%SystemRoot%/ServiceProfiles/*/AppData/Roaming/Microsoft/Windows/Cookies" },
        { "root": "%SystemRoot%/System32/config/systemprofile/AppData/Local/Microsoft/Windows/INetCookies" },
        { "root": "%SystemRoot%/System32/config/systemprofile/AppData/Roaming/Microsoft/Windows/Cookies" },
        { "root": "%SystemRoot%/SysWOW64/config/systemprofile/AppData/Local/Microsoft/Windows/INetCookies" },
        { "root": "%SystemRoot%/SysWOW64/config/systemprofile/AppData/Roaming/Microsoft/Windows/Cookies" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/INetCookies" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/!*/INetCookies" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/MicrosoftEdge/Cookies" },
        { "root": "%SystemDrive%/Users/*/AppData/Local/Packages/*/AC/!*/MicrosoftEdge/Cookies" }
      ]
    },
    {
      "id": "rdp-cache",
      "name": "远程桌面位图缓存",
      "group": "缓存",
      "description": "远程桌面客户端为加快显示保存的位图缓存。",
      "risk": "low",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemDrive%/Users/*/AppData/Local/Microsoft/Terminal Server Client/Cache" }]
    },
    {
      "id": "thumbnail-cache",
      "name": "缩略图和图标缓存",
      "group": "缓存",
      "description": "资源管理器保存的缩略图和图标缓存数据库。",
      "note": "资源管理器运行时这些文件多数被占用，会被自动跳过。",
      "risk": "low",
      "default_selected": false,
      "kind": "files",
      "targets": [
        {
          "root": "%SystemDrive%/Users/*/AppData/Local/Microsoft/Windows/Explorer",
          "include": ["thumbcache_*.db", "iconcache_*.db"]
        },
        { "root": "%SystemDrive%/Users/*/AppData/Local", "include": ["IconCache.db"] }
      ]
    },
    {
      "id": "prefetch",
      "name": "预读取文件",
      "group": "缓存",
      "description": "系统为加快程序启动记录的预读取数据。",
      "note": "清理后各程序第一次启动会变慢，系统会自动重建。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemRoot%/Prefetch" }]
    },
    {
      "id": "update-download",
      "name": "Windows 更新下载缓存",
      "group": "缓存",
      "description": "Windows 更新已下载的安装包。",
      "note": "正在下载或等待安装的更新会重新下载。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemRoot%/SoftwareDistribution/Download" }]
    },
    {
      "id": "delivery-optimization",
      "name": "传递优化缓存",
      "group": "缓存",
      "description": "传递优化服务下载 Windows 更新和应用商店应用时留下的缓存，也用来向其他电脑分享这些下载。",
      "risk": "low",
      "default_selected": false,
      "kind": "files",
      "min_age_hours": 24,
      "targets": [
        { "root": "%SystemRoot%/SoftwareDistribution/DeliveryOptimization" },
        { "root": "%SystemRoot%/ServiceProfiles/NetworkService/AppData/Local/Microsoft/Windows/DeliveryOptimization/Cache" }
      ]
    },
    {
      "id": "retail-demo",
      "name": "零售演示离线内容",
      "group": "缓存",
      "description": "Windows 零售演示模式（商店里的展示机）缓存的离线内容，普通电脑用不到。",
      "risk": "low",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%ProgramData%/Microsoft/Windows/RetailDemo" }]
    },
    {
      "id": "windows-old",
      "name": "以前的 Windows 安装",
      "group": "系统备份与回滚",
      "description": "系统升级或重置后在系统盘根目录留下的旧系统备份（Windows.old）。",
      "note": "删除后无法回退到以前的 Windows 版本。旧系统里的用户文件（Windows.old 下的 Users 目录）也会一起删除，先确认需要的文件已经取回。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemDrive%/Windows.old*" }]
    },
    {
      "id": "windows-setup-temp",
      "name": "Windows 升级临时文件",
      "group": "系统备份与回滚",
      "description": "系统升级或还原时在系统盘根目录建立的 $Windows.~BT、$Windows.~WS、$Windows.~LS 临时安装文件。",
      "note": "正在进行或等待重启完成的系统升级会失败；升级后的回退期内，回退也要用到这里的文件，删除后无法回退。确定当前没有在升级或还原时再清理。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [
        { "root": "%SystemDrive%/$Windows.~BT" },
        { "root": "%SystemDrive%/$Windows.~WS" },
        { "root": "%SystemDrive%/$Windows.~LS" }
      ]
    },
    {
      "id": "windows-dir-backups",
      "name": "Windows 目录下的 .bak 文件",
      "group": "系统备份与回滚",
      "description": "直接放在 Windows 目录里的 .bak 备份文件，多是程序修改系统配置文件前留下的。",
      "note": "删除后无法再用这些备份恢复被修改的原文件。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemRoot%", "include": ["*.bak"] }]
    },
    {
      "id": "startup-backup",
      "name": "启动信息备份（pss）",
      "group": "系统备份与回滚",
      "description": "Windows 目录下 pss 文件夹里的备份。原规则表说明是修改启动信息后系统留下的备份；系统配置（msconfig）停用启动文件夹里的项目时也把它们移到这里。",
      "note": "删除后无法再用这些备份回滚，在系统配置里停用的启动项也无法再恢复。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemRoot%/pss" }]
    },
    {
      "id": "last-known-good",
      "name": "最后一次正确配置的备份",
      "group": "系统备份与回滚",
      "description": "Windows 目录下 lastgood 文件夹里的备份，供“最后一次正确的配置”启动选项回滚驱动和系统文件。",
      "note": "删除后“最后一次正确的配置”无法再用这些文件回滚。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemRoot%", "include": ["lastgood", "lastgood.tmp"] }]
    },
    {
      "id": "hardlink-backup",
      "name": "硬链接合并备份",
      "group": "系统备份与回滚",
      "description": "Dism++ 的硬链接合并功能在系统盘根目录留下的 $HardLinkBackup 备份。",
      "note": "删除后硬链接合并无法回滚。先确认合并后系统一切正常。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemDrive%/$HardLinkBackup" }]
    },
    {
      "id": "package-cache",
      "name": "Package Cache 安装源",
      "group": "安装程序缓存",
      "description": "基于 WiX 的安装程序（Visual Studio、VC++ 运行库、.NET SDK 等）在 ProgramData 下缓存的安装源。",
      "note": "清理后这些程序的修复、升级、增删组件需要联网或准备安装包；部分程序在“应用和功能”里的卸载入口就是这里缓存的安装程序，删除后可能无法从那里卸载。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%ProgramData%/Package Cache" }]
    },
    {
      "id": "installer-patch-cache",
      "name": "Windows Installer 基线缓存",
      "group": "安装程序缓存",
      "description": "Windows Installer 为打补丁保存的原始文件基线（Installer 目录下的 $PatchCache$）。",
      "note": "清理后卸载补丁或修复 Office、虚拟机软件等程序时可能需要原始安装包。原规则表在装有苹果软件（iTunes 等）的电脑上不提供这一项，这类电脑不要勾选。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemRoot%/Installer/$PatchCache$" }]
    },
    {
      "id": "msocache",
      "name": "Office 本地安装源（MSOCache）",
      "group": "安装程序缓存",
      "description": "旧版 Office（MSI 安装）在系统盘根目录保存的本地安装源。",
      "note": "删除后 Office 无法正常卸载，只能升级安装或强行删除；Office 2007 及更早版本安装更新也会受影响。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemDrive%/MSOCache" }]
    },
    {
      "id": "office-c2r-cache",
      "name": "Office 即点即用安装源",
      "group": "安装程序缓存",
      "description": "Office 365、2016 及以后版本（即点即用安装）在 ProgramData 下保存的安装源，不含 MachineData 和 UserData。",
      "note": "清理后 Office 可能无法正常卸载、修复或更新，需要用微软的 Office 卸载工具处理或重新下载安装。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%ProgramData%/Microsoft/ClickToRun", "exclude": ["MachineData", "UserData"] }]
    },
    {
      "id": "webpi-cache",
      "name": "Web 平台安装程序缓存",
      "group": "安装程序缓存",
      "description": "微软 Web 平台安装程序（WebPI）下载的安装包和缓存。",
      "note": "WebPI 已停止服务，删除后这些安装包可能无法再下载；用它安装的组件修复时可能需要安装包。",
      "risk": "medium",
      "default_selected": false,
      "kind": "files",
      "targets": [{ "root": "%SystemDrive%/Users/*/AppData/Local/Microsoft/Web Platform Installer" }]
    },
    {
      "id": "driver-extract-dirs",
      "name": "驱动程序解压目录",
      "group": "安装程序缓存",
      "description": "Intel、AMD、NVIDIA 驱动安装时在系统盘根目录解压出的 AMD、Intel、NVIDIA 目录。",
